rules_version = '2';

// Security Rules cho MediBook
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // busy_slots/{doctorId}_{startAt ms}
    function busySlotPath(doctorId, startAt) {
      return /databases/$(database)/documents/busy_slots/$(doctorId + '_' + string(startAt.toMillis()));
    }

    function isStaff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    match /users/{uid} {
      // Chủ tài khoản đọc hồ sơ của mình; Staff được đọc hồ sơ khách hàng.
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Tự đăng ký: chỉ tạo được tài khoản customer
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['fullName', 'phone', 'role', 'profileCompleted', 'profilePromptDismissed',
              'createdAt', 'updatedAt'])
        && request.resource.data.role == 'customer'
        && request.resource.data.profileCompleted == false
        && request.resource.data.get('profilePromptDismissed', false) == false
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.auth.token.email == request.resource.data.phone + '@medibook.local';

      // Không được đổi role và phone
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'profileCompleted', 'profilePromptDismissed', 'updatedAt',
                       'email', 'birthDate', 'gender', 'avatar'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.get('profilePromptDismissed', false) is bool
        // email, ngày sinh, giới tính (tuỳ chọn)
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 100
        && (request.resource.data.get('birthDate', null) == null
            || (request.resource.data.birthDate is string
                && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (request.resource.data.get('gender', null) == null
            || request.resource.data.gender in ['male', 'female', 'other'])
        // Ảnh đại diện base64
        && request.resource.data.get('avatar', '') is string
        && request.resource.data.get('avatar', '').size() <= 200000;

      allow delete: if false;
    }

    // ----- TRA SĐT -> EMAIL ĐĂNG NHẬP -----
    // Đọc được khi chưa đăng nhập nhưng chỉ get từng SĐT, không list được
    match /login_index/{phone} {
      allow get: if true;
      allow list: if false;

      // Chỉ chủ tài khoản ghi được
      allow create, update: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == phone
        && request.resource.data.keys().hasOnly(['uid', 'emails', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emails is list
        && request.resource.data.emails.size() >= 1
        && request.resource.data.emails.size() <= 2;

      allow delete: if false;
    }

    // ----- LỊCH HẸN -----
    match /appointments/{id} {
      // Staff đọc tất cả; Customer chỉ đọc lịch của chính mình.
      allow read: if isStaff()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      // Customer đặt lịch cho chính mình, trạng thái pending; Staff chỉ tạo dữ liệu mẫu
      allow create: if (signedIn()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.isDemo == false
          && request.resource.data.keys().hasOnly(
               ['customerId', 'customerName', 'serviceName', 'startAt', 'endAt',
                'status', 'isDemo', 'createdAt', 'updatedAt', 'doctorId', 'doctorName'])
          && request.resource.data.get('doctorId', '') is string
          && request.resource.data.get('doctorName', '') is string
          && request.resource.data.customerName is string
          && request.resource.data.serviceName is string
          && request.resource.data.startAt is timestamp
          && request.resource.data.endAt is timestamp
          && request.resource.data.endAt > request.resource.data.startAt
          // Đặt trước tối đa 180 ngày (khớp BookingWindow.days)
          && request.resource.data.startAt < request.time + duration.value(180, 'd')
          // Chống đặt trùng: phải giữ được busy_slot trong cùng lần ghi
          && (!('doctorId' in request.resource.data)
              || (existsAfter(busySlotPath(request.resource.data.doctorId, request.resource.data.startAt))
                  && getAfter(busySlotPath(request.resource.data.doctorId, request.resource.data.startAt))
                       .data.appointmentId == id)))
        || (isStaff() && request.resource.data.isDemo == true);

      allow update: if
        // Staff xác nhận / từ chối lịch đang chờ
        (isStaff()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['confirmed', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt']))
        // Staff ghi lại dữ liệu mẫu
        || (isStaff()
          && resource.data.isDemo == true
          && request.resource.data.isDemo == true)
        // Customer hủy lịch của mình (lịch đã xác nhận: trước giờ khám ít nhất 2 giờ)
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status in ['pending', 'confirmed']
          && resource.data.startAt > request.time
          && (resource.data.status == 'pending'
              || resource.data.startAt > request.time + duration.value(2, 'h'))
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt']));

      allow delete: if false;
    }

    // ----- BÁC SĨ -----
    match /doctors/{id} {
      // Mọi người dùng đã đăng nhập được xem bác sĩ (Customer cần khi đặt lịch).
      allow read: if signedIn();

      // Staff chỉ ghi được bác sĩ mẫu
      allow create: if isStaff() && request.resource.data.isDemo == true;
      allow update: if isStaff()
        && resource.data.isDemo == true
        && request.resource.data.isDemo == true;

      allow delete: if false;
    }

    // ----- KHUNG GIỜ ĐÃ CÓ NGƯỜI ĐẶT -----
    // Không chứa thông tin khách hàng nên ai đăng nhập cũng đọc được
    match /busy_slots/{slotId} {
      allow read: if signedIn();

      // Customer giữ khung cùng lúc với tạo lịch hẹn; Staff chỉ tạo khung mẫu
      allow create: if (signedIn()
          && request.resource.data.keys().hasOnly(['doctorId', 'startAt', 'appointmentId', 'isDemo'])
          && request.resource.data.isDemo == false
          && request.resource.data.doctorId is string
          && request.resource.data.startAt is timestamp
          && slotId == request.resource.data.doctorId + '_' + string(request.resource.data.startAt.toMillis())
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
               .data.customerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
               .data.doctorId == request.resource.data.doctorId
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
               .data.startAt <= request.resource.data.startAt
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
               .data.endAt > request.resource.data.startAt)
        || (isStaff() && request.resource.data.isDemo == true);

      // Staff ghi lại khung mẫu
      allow update: if isStaff()
        && resource.data.isDemo == true
        && request.resource.data.isDemo == true;

      // Trả lại khung khi từ chối / hủy lịch
      allow delete: if isStaff()
        || (signedIn()
          && get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId))
               .data.customerId == request.auth.uid);
    }

    // ----- THÔNG BÁO CHO STAFF -----
    match /notifications/{id} {
      allow read: if isStaff();

      // Customer tạo thông báo khi đặt / hủy lịch; Staff chỉ tạo thông báo mẫu
      allow create: if (signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.isRead == false
          && request.resource.data.isDemo == false
          && request.resource.data.keys().hasOnly(
               ['title', 'body', 'createdAt', 'isRead', 'appointmentId', 'isDemo', 'createdBy'])
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
               .data.customerId == request.auth.uid)
        || (isStaff() && request.resource.data.isDemo == true);

      allow update: if
        // Staff đánh dấu đã đọc
        (isStaff()
          && request.resource.data.isRead == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
        // Staff ghi lại thông báo mẫu
        || (isStaff()
          && resource.data.isDemo == true
          && request.resource.data.isDemo == true);

      allow delete: if false;
    }

    // Mặc định chặn mọi thứ khác.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
